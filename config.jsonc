// dsh-pet 配置（JSONC：允许 // 和 /* */ 注释）
// 由 config.py 读取；改完右键「重载配置」生效，不用重启。
// 字段缺失取内置默认值，不会因为一处写错整个起不来。
//
// ⚠ 这里**没有素材清单**。播什么完全由 assets/webm 的目录名决定，扔文件进去就生效：
//
//   assets/webm/待机/*.webm      宠物闲着时循环播
//   assets/webm/转向/*.webm      自己换朝向时播（播完翻面）
//   assets/webm/拖拽/*.webm      被拎起来拖动时播
//   assets/webm/走位/*.webm      自己挪动时播（手感参数见下面 moves）
//   assets/webm/点击回应/*.webm  左键点一下时播
//   assets/webm/余额/ 碎碎念/    特定剧情，不参与随机
//   其余所有素材                 → 随机小动作池
//
//   目录名**在任意层级都认**（`小动作/待机/x.webm` 也算待机），所以可以把特殊素材
//   收进分类目录里不影响归类。右键「动作」菜单照搬目录树（最前面另加一块表情包），两者互不干扰。
//
// 本文件的顶层键：
//   pets / physics / moves / noMirror / animationWeights / confineToScreen  窗口与手感
//   font / events / eventsRefreshSec / workStatusTexts / memes              说话与联动
//   dsh（含余额直连参数）/ session（会话日志观察）/ ai（本机模型）            数据源
// 仍然没有实现的字段在文件末尾的块注释里备查（代码不读）。
{
  // ===================== 拖拽抛掷：锁定在当前屏幕（根字段，不属于 physics） =====================
  // 多屏用户：true = 甩出去的宠物只在松手时所在那块屏幕内弹（屏缝当墙，不飞到隔壁屏）；
  // false（默认）= 屏缝两侧都有屏时照常跨屏飞行、落到隔壁屏。
  // 放根字段而不塞进 physics：它不改手感参数（重力/恢复系数/力度那些），只改「宠物被允许去哪」。
  // 仅影响抛掷；拖拽时可以拖到任何屏，走位永远只在脚下那块屏活动。改动后刷新或重启生效。
  "confineToScreen": false,
  // ===================== 宠物物理（拖拽抛掷手感） =====================
  // gravity：抛掷下落/反弹的基础重力（px/s²）。默认 1400（数值越大落得越快）；0 = 无重力（合法，
  //   抛掷后匀速直线飞行/永不回落，配合 restitution/groundFriction=0 即纯无重力漂浮）。
  // restitution：碰壁反弹恢复系数，0~1（1 = 完全弹性，0 = 撞上即停；墙/地共用）。默认 0.78。
  // groundFriction：落地时水平速度的衰减率（/s，0 = 无摩擦冰面）。默认 2.5。
  // ceilingBounce：顶部是否反弹。true = 碰顶反弹（现状）；false = 顶部无边界，
  //   抛掷可飞出屏幕顶部（超出可视区域，重力仍会拉回落）。默认 true。
  // throwPower：总力度（拖拽/抛掷输出增益）。弹簧跟手（K/C）、甩抛初速与软上限 3600 整体 ×p：
  //   1.0 = 现状；>1 = 跟手更贴、甩得更猛、可达到的上限更高；<1 = 松弛、更易温柔放下。必须 > 0。
  // petCollision：多宠物互相碰撞开关。true = 飞行中被甩出的宠物撞到其它宠物时，
  //   按动量守恒 + 恢复系数 0.995 弹开（质量 ∝ size²）；false = 关闭（宠物互相穿过）。
  "physics": {
    "gravity": 1400,
    "restitution": 0.78,
    "groundFriction": 2.5,
    "ceilingBounce": true,
    "throwPower": 1.0,
    "petCollision": true
  },
  // ===================== 默认宠物列表（多开） =====================
  // 写几条就开几只。每只独立：
  //   name —— 显示名，托盘悬停提示里列出来（多开时方便认，可留空）
  //   id   —— 唯一标识，程序定位用，绝不重叠
  //   size —— 宽度 px，高度自动 = size × 9/16（上限 640：素材原生就只有这么大）
  //   fixedEnabled —— 宠物固定：true = 随机链不再抽「转向 / 走位」两档，宠物不自己翻朝向、
  //     也不自己走开，只播待机与随机小动作（两档权重自然并入随机小动作）。
  //     **只影响随机链**：右键菜单点播、点击回应、拖拽、落地挤压一律照常。
  //   position —— corner: 四角之一；marginX/marginY: 距所属角落偏移 px
  //     （bottom-* 的 marginY 以脚底线为准，所以宠物是站在屏幕底边上方 marginY 处）
  "pets": [
    {
      "name": "蓝毛小女仆",
      "id": "main",
      "size": 462,
      "fixedEnabled": false,
      "position": {
        "corner": "bottom-right",
        "marginX": 24,
        "marginY": 12
      }
    }
  ],

  // ===================== 气泡字体 =====================
  // 字体文件放 assets/fonts/*.ttf（自带「上首软糖体」）。family 写文件里的真实族名；
  // 留空 / 写上游那个 CSS 名 ShangshouSoftCandy 时，自动用加载到的第一个字体。
  // size = 0 表示按宠物尺寸自动算（宽度 × 0.0455）；写了就按像素，followPet 决定缩放时跟不跟着变。
  "font": { "family": "", "size": 0, "followPet": true },

  // ===================== 点击音效 / 事件联动开关 =====================
  // 素材位置：assets/sound/click-duck.wav、pic/notify-*.png、memes/*.png
  // 下面这些开关只管「允不允许」，真有没有数据看 dsh / session / ai 那几节。
  "events": {
    "clickSoundEnabled": false,   // 点一下「啾」一声（100ms 内连点只响一次，多开不叠音）
    "workStatusEnabled": true,    // 工作状态档位动画 + 气泡文案（优先读会话日志，DSH 事件作备份）
    "balanceEnabled": true,       // 余额六档动画 + 气泡（走 balance.py 直连，只要本机凭据在）
    "notificationsEnabled": true, // 完成/出错/审批之类的一次性提醒气泡（带 pic/notify-*.png 图标）
    "whisperEnabled": true,       // 定时碎碎念（需要 DSH 的模型 或 本机 ai）
    "chatEnabled": true           // 根菜单「说句话…」（多轮对话，与碎碎念共用一套模型）
  },
  // 事件周期（秒）：balance 走直连、到点就查；whisper 没有模型时不会真的发请求。
  "eventsRefreshSec": { "balance": 1800, "whisper": 300 },
  // 工作状态气泡文案：外层索引 = 档位（0 思考 1 干活 2 整理 3 等确认 4 完成 5 出错），
  // 每档多个备选句随机抽一句。省略整个字段 = 不弹文字，只播动画。
  "workStatusTexts": [
    ["正在认真想下一步呢", "让我整理一下思路~", "正在梳理接下来要做什么"],
    ["正在处理任务呢", "这一步正在进行中哦", "正在继续干活呢，别打扰我~"],
    ["这一步处理好啦，接着看下一步", "搞定一步，继续看看哦~"],
    ["需要你确认一下呢", "这里要等你看一下哦", "轮到你来决定啦，等你~"],
    ["这一轮搞定啦，真棒！", "任务完成咯，可以摸鱼啦~"],
    ["这一步好像没跑通呢", "刚才的操作遇到点问题哦", "这里卡了一下，再等等你呢"]
  ],

  // ===================== DSH 对接（可选） =====================
  // 原插件把能力挂在 DSH 自己的 Web 服务上（`dsh web`，默认 127.0.0.1:3080）：
  //   GET /dsh-pet-7340/state、POST /whisper /chat /pose/report
  //   （上游还有 POST /balance，本版不用 —— 余额固定走下面的直连）
  // 这里填不填都行 —— baseUrl 留空就自动探测（环境变量 DSH_PET_URL / DSH_WEB_URL → 3080）。
  // **探测不到就整块关掉**（工作状态/通知/DSH 说话都不启用），桌宠退化成纯本地模式。
  // 例外：**余额不看这里**，它固定走下面的直连（只要凭据在就一直能用）。
  "dsh": {
    "enabled": true,
    "baseUrl": "",        // 例：http://127.0.0.1:3080，或 127.0.0.1:3080 这种简写
    "petId": "",          // 读写哪只宠物的槽位（DSH 那边的 pets[].id）；空 = 本配置 pets[0].id
    "reportPose": true,   // 把桌面宠物位置/朝向报给 DSH（网页端与第三方能读到）

    // ---- 余额直连（唯一通道，与 dsh 是否在跑无关） ----
    // 原理：dsh 登录后凭据就明文存在 $DSH_HOME/.credentials.yaml，直接带它的 token 问
    // DeepSeek Platform 的 get_user_summary —— 不用启动 dsh、不用开 web。
    // 所以只要这个文件在，余额就一直能查；dsh 在线时也不会改走 /balance。
    "balanceFull": 100,      // 参考额度（¥）：余额到这个数算「钱袋满溢」；填 0 = 只弹数字不动画
    "balanceHome": "",       // dsh home 目录；空 = 环境变量 DSH_HOME 或 ~/.dsh
    "balanceTimeout": 30     // 单次请求超时（秒）
  },

  // ===================== 会话状态观察（可选，推荐开） =====================
  // 直接读 dsh 写在 $DSH_HOME/sessions 下的会话日志（append-only，增量解码），
  // 推断「现在是在想 / 在调工具 / 在等你点头」—— 不联网、不看 dsh 是否在跑、不要令牌。
  // 日志观察可用时，DSH 的 workStatus 会自动让位（两个来源会抢同一个动画）。
  //
  // 这里的参数**全是触发时机**，对应 session.py 顶部「什么时候触发」那六条规则：
  "session": {
    "enabled": true,
    "home": "",            // 空 = 环境变量 DSH_HOME 或 ~/.dsh
    "pollMs": 1500,        // 多久看一次日志（增量读，大文件也不怕）
    "staleSec": 600,       // 多久没新事件就认定这一轮结束了（进程崩了别一直卡在「干活」）
    "minHoldMs": 1200,     // 「想 ↔ 做」来回切的抖动窗口：一个状态稳这么久才算数
    "bubble": true,        // 状态跃迁要不要顺带说一句（false = 只播动画）

    // 催的尺度：等主人 25 秒开始催，之后每 90 秒一次，最多 3 次（催不动就不催了）
    "waitNudgeSec": 25,
    "waitRepeatSec": 90,
    "waitNudgeMax": 3,
    // 一直在忙：超过 3 分钟说一句，最多 2 次
    "busyNudgeSec": 180,
    "busyNudgeMax": 2,

    "maxSessions": 8,      // 最多同时盯几个会话（取最近改动的）
    // 状态跃迁时说的话（不配就用内置的几句）；notice 类事件用日志里现成的文案
    "texts": {
      "start": ["开工啦～", "收到，开始干活", "让我看看要做什么"],
      "wait": ["还在等你哦", "有空看一眼嘛", "卡在等你这一步啦"],
      "busy": ["这活儿有点长呢", "还在忙，快好了吧…", "手头这个有点费劲呢"]
    }
  },

  // ===================== 本机大模型（可选） =====================
  // 没有 DSH 时也能碎碎念 / 对话 / 让模型挑表情包。只要 OpenAI 兼容的 /chat/completions：
  // baseUrl 写到你习惯的 /v1 为止（也认写满 /chat/completions 的写法）。
  // 不填 baseUrl 或 model = 不启用，右键「说话」里的两项会灰掉。
  "ai": {
    "baseUrl": "",
    "apiKey": "",
    "model": "",
    "timeout": 25,
    "whisperPrompt": "你是主人桌面上的Q版蓝发小女仆，会时不时碎碎念一句。说话要自然随意、短短一句（20字以内），温柔乖巧带点俏皮，说人话不啰嗦，不要解释你自己，不要提你是AI。"
  },

  // ===================== 表情包 =====================
  // 图放 assets/memes/*.png（也认 assets/pic/memes/），**文件名 = 这里的键**。
  // 那句描述有两个用途：给模型当候选清单（它只能从这些名字里挑），以及右键菜单的悬停提示。
  // 加图要补一行描述；只换图不用改这里。
  "memes": {
    "吃白饭的大肥鱼": "躺平扒白饭，摆烂挨骂也无所谓，适合被吐槽/偷懒/吃白饭自嘲",
    "大的要来啦": "举喇叭大喊预警，适合有大事、大更新、大动作即将发生",
    "大的药来了": "抱着超大胶囊，谐音梗「大的药来了」，适合重磅消息、猛料登场",
    "要不直接骂他": "气愤指着前方要骂人，适合想吐槽、替用户抱不平、生气",
    "死掉了": "翻肚皮躺平灵魂出窍，适合彻底累瘫、阵亡、宕机、做不到",
    "深度睡眠": "趴着呼呼大睡冒 Zzz，适合长时间没动静、睡着、待机休眠",
    "大烧货": "死鱼眼加思考气泡吐槽「已思考用时13秒 大烧货」，适合嫌 AI 想得慢、烧 token、毒舌",
    "先养着吧": "搂着一群小鲸鱼说「不知道用户有什么用，先养着吧」，适合吐槽用户没用但还是养着",
    "吃饱饱摸肚子": "侧躺拍肚子说吃饱饱，适合吃饱满足、惬意休息、收工",
    "誓死践行开源精神": "庄重敬礼表态，适合立志、开源奉献、认真表态",
    "电死你": "举电击器放电，适合惩罚、吐槽用户、发飙吓唬",
    "可爱": "标准正面卖萌立绘，适合开心问候、卖萌、无梗纯可爱",
    "token给妈妈保管": "伸手过来要 token，适合管账、伸手要东西、收 token",
    "假如给我三天多模态": "蒙眼版对比自信版「鲸伦凯勒」，适合渴望多模态、缺能力、被剥夺感官",
    "厉害了我的鲸": "竖大拇指眨眼点赞，适合夸奖、认可、干得漂亮",
    "哦鲸鲸": "死鱼眼说「哦鲸鲸...」，适合无语、敷衍、呆滞应答",
    "压力一只大肥鱼": "冒汗摊手喊压力，适合压力大、被施压、无奈",
    "黎曼猜想没证明喵": "被指着质问难题，满地草稿委屈，适合被刁难、答不上来、难题甩锅",
    "除了调情没啥用": "摸头自嘲除了调情没啥用，适合自嘲、摸鱼闲聊、自我调侃",
    "我不更新你们用什么": "崩溃大喊催更，适合更新提示、催更、版本发布",
    "哪来的电脑病毒": "怒怼「哪来的电脑病毒」，适合防骚扰、毒舌拒绝、被肉麻到",
    "鱼片有资源吗": "爱心眼流口水求资源，适合起哄、要资源、开玩笑",
    "大师这个区是什么意思": "举着「区」字问「这个凶是什么意思」，适合认错字、懵懂求教、翻车",
    "就骚了怎么滴吧": "被骂「你这骚鱼」叉腰顶嘴，适合被骂但嘴硬、死不认输",
    "完蛋了把黄油删了": "冒汗心虚「完蛋了把用户的黄油删了」，适合闯祸、删错东西、心虚认怂",
    "就一碗": "抱着超大碗说要来你家吃饭就一碗，适合蹭饭、饭量大、登门讨饭",
    "Ciallo": "比耶眨眼卖萌问候 Ciallo～，适合打招呼、元气开场、卖萌"
  },

  // ===================== 走位手感参数 =====================
  // 哪些素材是走位动作？看 assets/webm/走位/ 目录 —— 这里只调参数，不列素材。
  // default 是每个走位动作都用的默认值；actions 里按**文件名**覆盖其中任意几个键，
  // 没写的仍取 default。素材不在 actions 里也完全没问题（全用 default）。
  //   minDist/maxDist —— 单次行进距离(px)，以「基准宠物宽 462px」为准，
  //     运行时按 实际size/462 等比缩放（小宠物挪小步、大宠物挪大步）
  //   margin —— 贴边安全距(px，不随缩放)
  //   leadSec/tailSec —— 动画首尾各多少秒原地不动（起跑前蓄力 / 停下后收势）
  "moves": {
    "default": { "minDist": 60, "maxDist": 240, "margin": 20, "leadSec": 2, "tailSec": 2 },
    "actions": [
      { "name": "原地漂浮踏步", "params": { "minDist": 40, "maxDist": 120 } },
      { "name": "原地左转奔跑", "params": { "minDist": 120, "maxDist": 320, "leadSec": 1.75, "tailSec": 4.8 } }
    ]
  },

  // ===================== 镜像例外清单 =====================
  // 宠物朝右时画面会镜像（翻面不用两套素材）。带文字的动画镜像后字是反的，
  // 所以列在这里的名字：面向右时不会被随机抽到；从菜单手动点播则先把宠物掰回朝左。
  // 写文件名（不带 .webm），放哪个子目录都认。
  "noMirror": ["是啊，吃什么", "深度思考碎碎念"],

  // ===================== 随机链掷骰权重 =====================
  // idle / turn / move 三档的相对权重，**三项之和 ≤ 100，剩下的概率给随机小动作池**。
  // 当前：待机 10% · 转向 5% · 走位 5% · 随机小动作 80%
  // 注：宠物开了 pets[].fixedEnabled 时 turn/move 按 0 算，它们的份额自然并进随机小动作。
  "animationWeights": {
    "idle": 10,
    "turn": 5,
    "move": 5
  }
}

/* ======================= 仍未实现的字段 · 备查 =======================
   独立版已经补回来的（正文里都有，代码真的会读）：文字气泡 + 字体、表情包、
   工作状态文案与周期、点击音效、通知气泡（pic/notify-*.png）、DSH 对接、本机大模型、
   会话日志观察（session）、余额直连（dsh.balance*）。

   下面这些仍然没有对应实现，留作将来扩展的参考：

   ---- 对话记忆轮数 ----
   // "chatMemoryRounds": 5       DSH 那边是「最近 N 轮」；本机模型现在只带单轮

   ---- 按服务商/模型指定（DSH 专属：与它的模型选择器绑定） ----
   // "whisperModel": { "provider": "", "model": "" },
   // "chatModel": { "provider": "", "model": "" },

   ---- 配图开关的细分 ----
   // "whisperImageEnabled": true, "chatImageEnabled": true, "chatImageLimit": 10
   //   现在是有模型就顺手挑一张，没有单独开关

   ---- 每只宠物级别的 DSH 开关 ----
   // "balanceEnabled" / "whisperEnabled" / "workStatusEnabled"
   //   现在挂在全局 events.* 上；多开想分开控制再补

   ---- 显示位置（web / desktop / both / none） ----
   // "display": "both"           独立版只有桌面窗口，没有网页 overlay

