# ── Python ──
__pycache__/
*.py[cod]
.venv/
.uv-cache/

# ── 素材源视频（体积大，自己保管） ──
video/src/*
!video/src/README.txt
video/*.mp4
video/*.mov
video/*.mkv
# 遮罩是要用的，别被上面一行带走
!video/watermark_mask_v5.mkv

# ── 打包产物 ──
build/
dist
*.spec

# ── 临时 ──
temp/
*.tmp
*.log
.workbuddy/_out_test/
# 投篮成绩记录（本机，不进 git）
basket-score.json
# Git Bash / Cygwin 崩溃转储（shell 被强杀时掉在 cwd，跟项目无关）
*.stackdump

# ── IDE / 系统 ──
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini
